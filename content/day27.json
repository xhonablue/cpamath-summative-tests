  ],
  "items": [
    {
      "id": "d27_q1",
      "type": "numeric_entry",
      "difficulty": "warm-up",
      "prompt": "Find |-9|.",
      "formula": "abs(-9)",
      "answer": 9,
      "rationale": "Absolute value is distance from 0, which is always non-negative: |-9| = 9."
    },
    {
      "id": "d27_q2",
      "type": "numeric_entry",
      "difficulty": "warm-up",
      "prompt": "Find |15|.",
      "formula": "abs(15)",
      "answer": 15,
      "rationale": "|15| = 15."
    },
    {
      "id": "d27_q3",
      "type": "multiple_choice",
      "difficulty": "grade-level",
      "prompt": "Which has the greater absolute value: -20 or 15?",
      "choices": {
        "A": "-20",
        "B": "15",
        "C": "They are equal",
        "D": "Cannot be determined"
      },
      "answer": "A",
      "rationale": "|-20| = 20, which is greater than |15| = 15."
    },
    {
      "id": "d27_q4",
      "type": "short_answer",
      "difficulty": "challenge",
      "prompt": "Order these numbers from least to greatest: -5, 2, -1, 0",
      "answer": "-5, -1, 0, 2",
      "rationale": "On the number line, -5 is furthest left, then -1, then 0, then 2."
    },
    {
      "id": "d27_q5",
      "type": "multiple_choice",
      "difficulty": "grade-level",
      "prompt": "A number's absolute value represents:",
      "choices": {
        "A": "Its distance from zero on the number line",
        "B": "Whether it's positive or negative",
        "C": "Its distance from 100",
        "D": "Half its value"
      },
      "answer": "A",
      "rationale": "Absolute value measures distance from zero, so it is always non-negative."
    }
  ],
